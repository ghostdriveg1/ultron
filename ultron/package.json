{
  "name": "ultron",
  "version": "3.1.0",
  "private": true,
  "description": "Ultron v3 — Autonomous AI Agent System",
  "workspaces": [
    "cloudflare_worker",
    "website"
  ],
  "scripts": {
    "dev:worker": "cd cloudflare_worker && npx wrangler dev",
    "dev:website": "cd website && npm run dev",
    "deploy:worker": "cd cloudflare_worker && npx wrangler deploy",
    "deploy:website": "cd website && npm run build"
  },
  "dependencies": {
    "wrangler": "^3.0.0",
    "@cloudflare/workers-types": "^4.0.0",
    "hono": "^4.0.0",
    "discord-interactions": "^3.0.0",
    "puter": "^1.0.0"
  }
}
